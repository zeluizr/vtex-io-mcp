{
  "name": "vtex-io-mcp",
  "version": "0.1.2",
  "description": "MCP server for VTEX IO development — Store Framework, React, Node services, GraphQL, Admin, and more",
  "type": "module",
  "bin": {
    "vtex-io-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "lint": "tsc --noEmit",
    "dev": "tsc --watch",
    "ingest:courses": "tsx scripts/ingest-vtex-courses.ts",
    "ingest:apps": "tsx scripts/ingest-vtex-app-docs.ts",
    "inspect": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "files": [
    "build",
    "data"
  ],
  "keywords": [
    "mcp",
    "vtex",
    "vtex-io",
    "store-framework",
    "ecommerce",
    "react",
    "node",
    "graphql"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://vtex-io-mcp.zeluizr.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeluizr/vtex-io-mcp.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0"
  }
}
